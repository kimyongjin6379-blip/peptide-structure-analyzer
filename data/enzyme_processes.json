  "enzymes": {
    "Alcalase": {
      "manufacturer": "Novozymes",
      "source": "Bacillus licheniformis",
      "type": "endopeptidase",
      "subtype": "subtilisin (serine protease)",
      "merops_id": "S08.001",
      "specificity": "broad",
      "cleaves_after": ["F", "Y", "W", "L", "M", "A"],
      "exo_activity": false,
      "optimum_pH": [7.0, 9.0],
      "optimum_temp_c": [55, 65],
      "function_summary": "광범위 endopeptidase, 큰 펩타이드 1차 분해"
    },

    "Flavourzyme": {
      "manufacturer": "Novozymes",
      "source": "Aspergillus oryzae",
      "type": "complex (endo + exo)",
      "subtype": "peptidase complex (Leucyl aminopeptidase + endoprotease)",
      "specificity": "broad",
      "cleaves_after": "broad random",
      "exo_activity": true,
      "exo_targets": ["L", "I", "V", "F", "Y"],
      "exo_terminal": "both_N_and_C",
      "optimum_pH": [5.0, 7.0],
      "optimum_temp_c": [50, 55],
      "function_summary": "endo + exo 복합활성, 유리 AA 방출 + debittering"
    },

    "ZF101": {
      "manufacturer": "Angel Yeast",
      "product_name": "Annzyme Complex Protease ZF101",
      "source": "Yeast-based complex",
      "type": "complex (endo + exo)",
      "subtype": "복합 단백질 분해 효소",
      "specificity": "broad",
      "cleaves_after": "broad random (DH-controlled)",
      "target_avg_peptide_mw": 1000,
      "exo_activity": true,
      "exo_targets": ["L", "I", "V", "F", "Y"],
      "exo_terminal": "both_N_and_C",
      "exo_function": "hydrophobic_terminal_trimming (debittering)",
      "optimum_pH": [6.0, 7.5],
      "optimum_temp_c": [55, 60],
      "primary_use": "HVP / 식물성 펩톤 생산",
      "function_summary": "Flavourzyme 유사 (endo + exo + 쓴맛 억제)",
      "note": "정확한 cleavage specificity 미공개 (제조사 NDA 필요)"
